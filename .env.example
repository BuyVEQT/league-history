# Not needed for the demo — the app runs with no environment variables.
# These will be needed once Yahoo Fantasy API access is approved (see docs/YAHOO.md).
# Never commit real values; set them in Vercel's Project Settings → Environment Variables.

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match the redirect URI registered with Yahoo, e.g. https://yourdomain.com/api/auth/yahoo/callback
YAHOO_REDIRECT_URI=
# Random 32+ byte secret used to sign the session cookie / encrypt stored tokens
SESSION_SECRET=
